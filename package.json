{
  "name": "pdfedit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "engine:install": "python3 -m venv .venv && .venv/bin/python -m pip install -r engine/requirements.txt",
    "engine:serve": "node server/pdf-engine-server.mjs",
    "serve": "node server/pdf-engine-server.mjs",
    "ensure:qpdf": "node tests/ensure-qpdf.mjs",
    "ensure:ocr": "node tests/ensure-ocr.mjs",
    "test:engine": "node tests/run-engine-tests.mjs",
    "test:corpus": "REQUIRE_QPDF=1 node tests/engine-corpus-100.mjs && node tests/corpus-smoke.mjs",
    "test:claim-boundary": "node tests/release-claim-boundary.mjs",
    "test:standards-boundary": "node tests/standards-validator-boundary.mjs",
    "test:manual-smoke-package": "node tests/manual-smoke-package.mjs",
    "test:release-smoke": "node tests/release-smoke.mjs",
    "package:local": "node scripts/package-local.mjs",
    "test:package-smoke": "npm run package:local && node tests/package-smoke.mjs",
    "test:e2e": "playwright test",
    "verify:external": "npm run verify:local && npm run test:corpus && npm run test:claim-boundary && npm run test:standards-boundary && npm run test:manual-smoke-package && npm run test:release-smoke && npm run test:package-smoke",
    "verify:local": "npm run ensure:qpdf && npm run ensure:ocr && REQUIRE_QPDF=1 VITE_STRICT_ENGINE=true npm run build && REQUIRE_QPDF=1 REQUIRE_OCR=1 npm run test:engine && REQUIRE_QPDF=1 VITE_STRICT_ENGINE=true npm run test:e2e -- --reporter=list && npm audit --audit-level=moderate",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
}
